POSTGRES_USER=SEU_USER_AQUI
POSTGRES_PASSWORD=SUA_SENHA_AQUI
POSTGRES_DB=SEU_DB_AQUI

DOCKER_INFLUXDB_INIT_USERNAME=SEU_USER_AQUI
DOCKER_INFLUXDB_INIT_PASSWORD=SUA_SENHA_AQUI
DOCKER_INFLUXDB_INIT_ORG=SUA_ORG_AQUI
DOCKER_INFLUXDB_INIT_BUCKET=SEU_BUCKET_AQUI
DOCKER_INFLUXDB_INIT_ADMIN_TOKEN=SEU_TOKEN_AQUI

# --- Conexao do backend (rodando na maquina host) ---
# Ao dockerizar o backend, troque localhost por: postgres
DATABASE_URL=postgresql+psycopg2://gasguard:SUA_SENHA_AQUI@localhost:5432/gasguard

# --- Cliente InfluxDB (backend rodando na maquina host) ---
# Ao dockerizar o backend, troque localhost por: influx
INFLUX_URL=http://localhost:8086
INFLUX_TOKEN=${DOCKER_INFLUXDB_INIT_ADMIN_TOKEN}
INFLUX_ORG=${DOCKER_INFLUXDB_INIT_ORG}
INFLUX_BUCKET=${DOCKER_INFLUXDB_INIT_BUCKET}

# --- Broker MQTT (backend rodando na maquina host) ---
# Ao dockerizar o backend, troque localhost por: mosquitto
# Nao sao segredos: sao os valores que funcionam com o docker-compose deste repo.
# O '+' e o coringa de UM nivel: casa com qualquer <codigo> de dispositivo.
MQTT_HOST=localhost
MQTT_PORT=1883
MQTT_TOPIC=gasguard/+/leitura
