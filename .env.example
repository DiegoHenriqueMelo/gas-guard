# NAO copie este arquivo na mao: rode
#
#     python scripts/gerar_segredos.py
#
# que gera o .env com senhas aleatorias (e os arquivos de secrets/). Este
# exemplo so mostra QUAIS variaveis existem. Nenhuma senha vai para o Git.

# --- PostgreSQL ---
POSTGRES_USER=gasguard
POSTGRES_DB=gasguard
POSTGRES_PASSWORD=gerada-pelo-script

# --- InfluxDB (o init so roda com o volume vazio) ---
DOCKER_INFLUXDB_INIT_USERNAME=gasguard
DOCKER_INFLUXDB_INIT_PASSWORD=gerada-pelo-script
DOCKER_INFLUXDB_INIT_ORG=gasguard
DOCKER_INFLUXDB_INIT_BUCKET=sensores
DOCKER_INFLUXDB_INIT_ADMIN_TOKEN=gerado-pelo-script

# --- API ---
JWT_SEGREDO=gerado-pelo-script

# --- RabbitMQ: um usuario por servico ---
RABBIT_SENHA_API=gerada-pelo-script
RABBIT_SENHA_GATEWAY=gerada-pelo-script
RABBIT_SENHA_GRAVADOR=gerada-pelo-script
RABBIT_SENHA_REGRAS=gerada-pelo-script
RABBIT_SENHA_INFERENCIA=gerada-pelo-script
RABBIT_SENHA_LAB=gerada-pelo-script
RABBIT_SENHA_ADMIN=gerada-pelo-script

# --- Mosquitto: sem anonimo, um usuario por papel ---
MQTT_SIMULADOR_SENHA=gerada-pelo-script
MQTT_GATEWAY_SENHA=gerada-pelo-script
MQTT_OBSERVADOR_SENHA=gerada-pelo-script

# --- Usuarios de demonstracao (login no painel) ---
DEMO_SENHA_ADMINISTRADOR=gerada-pelo-script
DEMO_SENHA_OPERADOR=gerada-pelo-script
DEMO_SENHA_VISUALIZADOR=gerada-pelo-script

# --- LLM local ---
OLLAMA_MODELO=llama3.2:3b
