# ==============================================================================
# .gitignore — Monorepo IoT (backend Python + frontend Vue)
# Estrutura assumida: /backend (Python)  |  /frontend (Vue)
# ==============================================================================


# ------------------------------------------------------------------------------
# GERAL / SISTEMA OPERACIONAL
# ------------------------------------------------------------------------------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
*.lnk


# ------------------------------------------------------------------------------
# EDITORES / IDEs
# ------------------------------------------------------------------------------
.vscode/*
!.vscode/extensions.json
!.vscode/settings.example.json
.idea/
*.iml
*.iws
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
*~


# ------------------------------------------------------------------------------
# SEGREDOS / VARIÁVEIS DE AMBIENTE  (nunca commitar!)
# ------------------------------------------------------------------------------
.env
.env.*
!.env.example
!.env.template
*.pem
*.key
*.p12
secrets.json
credentials.json
COMANDS.MD

# ==============================================================================
# BACKEND — PYTHON
# ==============================================================================

# Bytecode / cache
__pycache__/
*.py[cod]
*$py.class
*.so

# Ambientes virtuais
.venv/
venv/
env/
ENV/
.python-version
Pipfile.lock

# Distribuição / build
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib60/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# Testes / cobertura
.pytest_cache/
.tox/
.nox/
.coverage
.coverage.*
coverage.xml
htmlcov/
.cache
nosetests.xml
*.cover
.hypothesis/

# Linters / type checkers
.mypy_cache/
.dmypy.json
dmypy.json
.ruff_cache/
.pytype/

# Frameworks web
instance/
.webassets-cache
local_settings.py
staticfiles/
mediafiles/

# Banco de dados local (SQLite — comum em protótipo IoT)
*.db
*.sqlite
*.sqlite3
*.db-journal

# Jupyter (útil se você analisar os dados do sensor)
.ipynb_checkpoints/
*.ipynb_checkpoints

# Celery / filas
celerybeat-schedule
celerybeat.pid


# ==============================================================================
# FRONTEND — VUE / NODE
# ==============================================================================

# Dependências
node_modules/
.pnp
.pnp.js
jspm_packages/
web_modules/

# Build de produção
dist/
dist-ssr/
build/
.output/
.nuxt/
.nitro/
.vite/
.temp/

# Cache de ferramentas
.eslintcache
.stylelintcache
.parcel-cache/
.rpt2_cache/
.rts2_cache_*/
*.tsbuildinfo

# Logs de package managers
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
.npm
.yarn-integrity
.yarn/cache
.yarn/unplugged
.yarn/build-state.yml
.yarn/install-state.gz

# Testes E2E
/cypress/videos/
/cypress/screenshots/
/test-results/
/playwright-report/
/playwright/.cache/

# Vue local
*.local


# ==============================================================================
# ARDUINO / FIRMWARE  (se o código do microcontrolador ficar no monorepo)
# ==============================================================================
.pio/
.pioenvs/
.piolibdeps/
.vscode/.browse.c_cpp.db*
.vscode/c_cpp_properties.json
.vscode/ipch/
*.hex
*.elf
*.bin
*.o
*.d
firmware/build/


# ==============================================================================
# DOCKER / INFRA
# ==============================================================================
docker-compose.override.yml
*.tar
.volumes/
data/postgres/
data/redis/


# ==============================================================================
# LOGS E ARQUIVOS TEMPORÁRIOS
# ==============================================================================
*.log
logs/
tmp/
temp/
*.pid
*.seed
*.pid.lock


# ==============================================================================
# DADOS COLETADOS DOS SENSORES
# Descomente se os CSVs de leitura forem grandes ou gerados automaticamente.
# Se forem parte do trabalho entregue, mantenha versionados!
# ==============================================================================
# data/raw/
# data/*.csv
# *.parquet